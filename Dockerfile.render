FROM python:3.12-slim

WORKDIR /app

COPY requirements-render.txt ./
RUN pip install --no-cache-dir -r requirements-render.txt

COPY backend ./backend
COPY data/structured/render_index ./data/structured/render_index

ENV PORT=8000
EXPOSE 8000

CMD ["python", "-m", "backend.main", "--index", "data/structured/render_index", "--lexical-only"]
